// middleware.ts - MINIMAL VERSION
import { withAuth } from "next-auth/middleware"

export default withAuth(
  function middleware() {
    // No additional logic needed - layout handles protection
  },
  {
    callbacks: {
      authorized: ({ token, req }) => {
        // Only protect dashboard routes in middleware
        if (req.nextUrl.pathname.startsWith('/dashboard')) {
          return !!token
        }
        return true
      },
    },
  }
)

export const config = {
  matcher: [
    '/dashboard/:path*' // ✅ Only protect dashboard routes
  ]
}